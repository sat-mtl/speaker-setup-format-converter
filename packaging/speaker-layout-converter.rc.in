#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/speaker-layout-converter.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Societe des Arts Technologiques"
      VALUE "FileDescription",  "Speaker Layout Converter"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "InternalName",     "speaker-layout-converter"
      VALUE "LegalCopyright",   "Societe des Arts Technologiques"
      VALUE "OriginalFilename", "speaker-layout-converter.exe"
      VALUE "ProductName",      "Speaker Layout Converter"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
